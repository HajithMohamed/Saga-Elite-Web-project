# Copy this file to e2e/.env.test (gitignored) and fill in values.
# Playwright config and global-setup load from this file at process start.

# Dedicated Mongo URI for the E2E test database. Will be wiped by global-setup.
# Use a different DB name from your dev DB to avoid data loss.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/saga_elite_test

# JWT secret for the test backend (must be >= 32 characters).
JWT_SECRET=test-jwt-secret-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# Optional: override the ports if 5001/5173 are taken on your machine.
# E2E_BACKEND_PORT=5001
# E2E_FRONTEND_PORT=5173
# E2E_BASE_URL=http://localhost:5173
# E2E_BACKEND_URL=http://localhost:5001

# Cloudinary stubs — must be present so the server boots, but no real uploads
# happen during tests.
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-key
CLOUDINARY_API_SECRET=test-secret
