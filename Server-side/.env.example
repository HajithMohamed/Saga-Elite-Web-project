# =============================================================================
# Saga Elite — BACKEND environment template (Railway / any Node host)
# =============================================================================
# Copy the keys you need into your host's environment-variable settings.
# NEVER commit a filled-in .env — only this template is tracked.
#
# For LOCAL development the project reads a single root-level .env (see the root
# .env.example); these per-workspace templates document what each deployment
# TARGET needs. On Railway, set these in the service's Variables tab.
# -----------------------------------------------------------------------------

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=5001                 # Railway injects its own PORT; this is the local default
LOG_LEVEL=info            # debug | info | warn | error

# ---- Database (MongoDB Atlas) — REQUIRED ----------------------------------
# The code reads MONGO_DB_URI. The other two are aliases kept for older tooling;
# set them to the same value if anything in your stack references them.
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=
MONGODB_URI=

# ---- JWT / auth — REQUIRED ------------------------------------------------
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
OTP_EXPIRES_IN=10

# ---- Frontend / CORS — REQUIRED in production -----------------------------
# FRONTEND_URL (or FRONTEND_URLS) gates CORS + Socket.IO origins in production.
FRONTEND_URL=https://your-site.netlify.app
CLIENT_URL=https://your-site.netlify.app
# Optional: comma-separated list if you serve more than one origin.
FRONTEND_URLS=
BACKEND_URL=https://your-api.up.railway.app

# ---- Cloudinary (image uploads) -------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Email / SMTP ---------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Fallback names supported by the app, useful for Gmail app-password setups.
EMAIL=your_fallback_smtp_email@example.com
PASS=your_fallback_smtp_password
FROM_EMAIL=noreply@example.com
FROM_NAME=Saga Elite
ADMIN_EMAIL=admin@example.com

# ---- Social login (OPTIONAL — blank disables the feature) -----------------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Payments (OPTIONAL) --------------------------------------------------
# PayHere card gateway. When both ID + SECRET are set, the card-payment page
# launches the real PayHere popup; otherwise it falls back to the sample form.
# The notify webhook needs a PUBLIC backend URL — set BACKEND_URL (above), or
# override the full URL with PAYHERE_NOTIFY_URL. Add the same notify URL under
# your PayHere merchant dashboard → Settings → Domains & Credentials.
# Localhost/private URLs are rejected for real PayHere starts because PayHere
# cannot send IPNs to them.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# PAYHERE_NOTIFY_URL=https://your-api.up.railway.app/api/webhooks/payhere

# Manual bank-transfer display details (OPTIONAL — shown on the checkout page)
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_ACCOUNT_NAME=Saga Elite
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_BANK_BRANCH=
MANUAL_PAYMENT_SWIFT_CODE=
MANUAL_PAYMENT_CURRENCY=LKR
MANUAL_PAYMENT_SUPPORT_EMAIL=
MANUAL_PAYMENT_ADMIN_EMAILS=

# ---- Bank inbox watcher / SMS webhook (OPTIONAL — auto-confirm transfers) --
BANK_INBOX_ENABLED=false
BANK_INBOX_HOST=imap.gmail.com
BANK_INBOX_PORT=993
BANK_INBOX_TLS=true
BANK_INBOX_USER=
BANK_INBOX_PASSWORD=
BANK_NOTIFICATION_FROM_ADDRESSES=
BANK_SMS_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (OPTIONAL — order alerts / OTP) -------------------
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORDER_NOTIFY_NUMBERS=

# ---- Anthropic / Claude (OPTIONAL — AI Insights + review classification) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
