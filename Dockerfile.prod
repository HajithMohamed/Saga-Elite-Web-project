# ── Saga Elite Backend · Production ───────────────────────────
# Build context: project root (.)
# Usage: docker compose -f docker-compose.prod.yml up --build backend
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /workspace/Server-side

# Install production dependencies only
COPY Server-side/package.json Server-side/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Copy application source
COPY Server-side/ .

# Non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /workspace
USER appuser

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:5001/api/v1/health',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
