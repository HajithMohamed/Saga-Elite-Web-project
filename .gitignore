# Workspace-level gitignore for Saga-Elite project
# This file applies to all subdirectories unless overridden by a more
# specific ignore file.

# Node artifacts
node_modules/
npm-debug.log

# Environment files
.env
.env.local
.env.*.local
.env.production

# Build / output
dist/
build/

# Logs
*.log

# macOS
.DS_Store

# Coverage reports
coverage/

# Playwright artifacts
e2e/.env.test
e2e/playwright-report/
e2e/test-results/
playwright-report/
test-results/

# Docker
docker-compose.override.yml

# IDE / editor
.vscode/
.idea/

# Additional ignores can be added in subfolder .gitignore files if needed
