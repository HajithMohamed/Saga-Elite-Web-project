# ==============================================
# SAGA ELITE - Workspace Environment Variables Template
# ==============================================
# Copy this file to .env at the workspace root and fill in your values.
# This file is used by docker-compose as well as the package.json scripts
# defined at the root of the repository.
# DO NOT commit an actual .env file containing real secrets.

# ---------- Backend configuration ----------
BACKEND_PORT=5001           # port mapping exposed by docker-compose
# the backend process itself expects PORT; mirror the value below
PORT=${BACKEND_PORT}

NODE_ENV=development        # development | production

# database (either local or atlas)
MONGO_DB_URI=mongodb://localhost:27017
# you may also set the alternate name used in the code
MONGODB_URI=${MONGO_DB_URI}

# jwt
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# email (development/testing using Mailtrap shown, swap for real provider)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-username
MAILTRAP_PASS=your-mailtrap-password
# or for production uncomment and fill one of the following sets:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-character-app-password
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@shoebank.lk

# frontend url (used for CORS configuration in backend)
FRONTEND_URL=http://localhost:5174

# otp
OTP_EXPIRES_IN=10
OTP_LENGTH=6

# file upload
MAX_FILE_SIZE=5
MAX_FILES_PER_PRODUCT=5

# security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# admin credentials for initial setup
ADMIN_EMAIL=admin@sagaelite.lk
ADMIN_PASSWORD=ChangeThisPassword123!

# google oauth
GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------- Frontend configuration ----------
VITE_API_URL=http://localhost:${BACKEND_PORT}/api

# (additional VITE_ variables can be defined here as needed)
