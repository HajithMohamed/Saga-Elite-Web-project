# ==============================================
# SAGA ELITE - Workspace Environment Variables Template
# ==============================================
# Copy this file to .env at the workspace root and fill in your values.
# This file is used by docker-compose as well as the package.json scripts
# defined at the root of the repository.
# DO NOT commit an actual .env file containing real secrets.

# ---------- Backend configuration ----------
BACKEND_PORT=5001
FRONTEND_PORT=5174

# the backend process itself expects PORT; mirror the value below
PORT=${BACKEND_PORT}

NODE_ENV=development

# database (either local or atlas)
# If backend runs inside Docker and MongoDB runs on your computer,
# use host.docker.internal rather than localhost.
# If running everything outside Docker, you can change this to:
# mongodb://localhost:27017/sagaelite
MONGO_DB_URI=mongodb://host.docker.internal:27017/sagaelite

# alternate variable name used in code
MONGODB_URI=${MONGO_DB_URI}

# jwt
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz
CLOUDINARY_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_SECRET=${CLOUDINARY_API_SECRET}

# email
# the current backend code reads EMAIL and PASS directly.
EMAIL=your-email@gmail.com
PASS=your-16-character-app-password

# frontend url (used for CORS configuration in backend)
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# optional comma-separated list if you also access the app via LAN IPs
FRONTEND_URLS=

# otp
OTP_EXPIRES_IN=10
OTP_LENGTH=6

# file upload
MAX_FILE_SIZE=5
MAX_FILES_PER_PRODUCT=5

# security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# admin credentials for initial setup
ADMIN_EMAIL=admin@sagaelite.lk
ADMIN_PASSWORD=ChangeThisPassword123!

# google oauth
GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------- Frontend configuration ----------
VITE_API_URL=http://localhost:${BACKEND_PORT}/api
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# (additional VITE_ variables can be defined here as needed)