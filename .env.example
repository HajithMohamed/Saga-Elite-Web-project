# ─── MONGODB ATLAS ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_random_string_minimum_32_characters
JWT_EXPIRE=7d

# ─── SERVER ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── CORS / URLS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# ─── PAYHERE ──────────────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true

# ─── CLOUDINARY ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── NODEMAILER / SMTP ────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
ADMIN_EMAIL=admin@sagaelite.lk
FROM_EMAIL=noreply@sagaelite.lk
FROM_NAME=Saga Elite

# ─── MANUAL PAYMENT BANK DETAILS ──────────────────────────────────────
BANK_NAME=Commercial Bank of Ceylon
BANK_ACCOUNT_NAME=Saga Elite
BANK_ACCOUNT_NUMBER=XXXX-XXXX-XXXX-XXXX
BANK_BRANCH=Kandy
MOBILE_BANKING_1_NAME=eZ Cash
MOBILE_BANKING_1_NUMBER=+94771234567

# ─── VITE FRONTEND ───────────────
VITE_API_URL=http://localhost:5001/api/v1
