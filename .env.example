# Database
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Runtime
NODE_ENV=development
PORT=5001
BACKEND_PORT=5001
LOG_LEVEL=debug

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
VITE_API_URL=http://localhost:5001/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_ID=your_google_client_id

# OTP
OTP_EXPIRES_IN=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Mail
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL=your_fallback_smtp_email@example.com
PASS=your_fallback_smtp_password
FROM_EMAIL=noreply@example.com
FROM_NAME=Saga Elite
ADMIN_EMAIL=admin@example.com

# Payments
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true

# Manual bank transfer
MANUAL_PAYMENT_BANK_NAME=Your Bank Name
MANUAL_PAYMENT_ACCOUNT_NAME=Saga Elite
MANUAL_PAYMENT_ACCOUNT_NUMBER=0000000000
MANUAL_PAYMENT_BANK_BRANCH=Main Branch
MANUAL_PAYMENT_SWIFT_CODE=ABCDEF12
MANUAL_PAYMENT_CURRENCY=LKR
MANUAL_PAYMENT_TRANSFER_NOTE=Use your generated reference number in the transfer note.
MANUAL_PAYMENT_SUPPORT_EMAIL=support@example.com
MANUAL_PAYMENT_SUPPORT_WHATSAPP=+94000000000
MANUAL_PAYMENT_ADMIN_EMAILS=admin1@example.com,admin2@example.com
MANUAL_PAYMENT_ADMIN_WHATSAPP_NUMBER=+94000000000
MANUAL_PAYMENT_ADMIN_WHATSAPP_NUMBERS=+94000000000,+94000000001

# Legacy/manual payment display fallbacks still referenced in some older flows
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Saga Elite
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH=Main Branch
MOBILE_BANKING_1_NAME=eZ Cash
MOBILE_BANKING_1_NUMBER=+94000000000

# WhatsApp API
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
