{
  "name": "saga-elite-web-project",
  "version": "1.0.0",
  "description": "_Unisex | Youth-Driven | Statement Style_  \r **Tagline:** Rare Fit Forever",
  "private": true,
  "main": "index.js",
  "type": "commonjs",
  "workspaces": [
    "Server-side",
    "Client-Side"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n BACKEND,FRONTEND -c blue,green \"npm --prefix Server-side run dev\" \"npm --prefix Client-Side run dev\"",
    "dev:backend": "npm --prefix Server-side run dev",
    "dev:frontend": "npm --prefix Client-Side run dev",
    "start": "node Server-side/server.js",
    "build": "npm --prefix Client-Side run build",
    "lint": "npm --prefix Server-side run lint && npm --prefix Client-Side run lint",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HajithMohamed/Saga-Elite-Web-project.git"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "saga-elite",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "Hajith Mohamed",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HajithMohamed/Saga-Elite-Web-project/issues"
  },
  "homepage": "https://github.com/HajithMohamed/Saga-Elite-Web-project#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "tailwindcss": "^3.4.19"
  }
}
