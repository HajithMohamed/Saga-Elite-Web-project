{
  "name": "saga-elite-web-project",
  "version": "1.0.0",
  "description": "_Unisex | Youth-Driven | Statement Style_  \r **Tagline:** Rare Fit Forever",
  "private": true,
  "main": "index.js",
  "type": "commonjs",
  "workspaces": [
    "Server-side",
    "Client-Side"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n BACKEND,FRONTEND -c blue,green \"npm run dev --workspace=Server-side\" \"npm run dev --workspace=Client-Side\"",
    "start": "node Server-side/server.js",
    "build": "npm run build --workspace=Client-Side",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HajithMohamed/Saga-Elite-Web-project.git"
  },
