{
  "name": "saga-elite-web-project",
  "version": "1.0.0",
  "description": "Saga Elite — Sri Lankan luxury fashion e-commerce. Tagline: Rare Fit Forever.",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "Server-side",
    "Client-Side"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:backend": "npm --prefix Server-side run dev",
    "dev:frontend": "npm --prefix Client-Side run dev",
    "start": "node Server-side/server.js",
    "build": "npm --prefix Client-Side run build",
    "lint": "npm --prefix Server-side run lint && npm --prefix Client-Side run lint",
    "audit": "npm --prefix Server-side audit && npm --prefix Client-Side audit",
    "test": "npm --prefix Server-side test && npm --prefix Client-Side test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HajithMohamed/Saga-Elite-Web-project.git"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "saga-elite",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "Hajith Mohamed",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HajithMohamed/Saga-Elite-Web-project/issues"
  },
  "homepage": "https://github.com/HajithMohamed/Saga-Elite-Web-project#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
