# =============================================================================
# Saga Elite — FRONTEND environment template (Netlify / any static host)
# =============================================================================
# Only variables prefixed with VITE_ are exposed to the browser bundle, so do
# NOT put backend secrets here. These are read at BUILD time.
#
# On Netlify, set these under Site settings → Environment variables.
# For LOCAL development the project reads the single root-level .env instead
# (Vite is configured with envDir: '../').
# -----------------------------------------------------------------------------

# ---- API + realtime (REQUIRED) --------------------------------------------
# Absolute backend URL including the /api suffix (the app appends /v1 itself).
VITE_API_URL=https://your-api.up.railway.app/api

# Socket.IO origin. Optional — if blank it is derived from VITE_API_URL by
# stripping the /api path. Set it explicitly if your socket host differs.
VITE_SOCKET_URL=https://your-api.up.railway.app

# ---- Branding (OPTIONAL) --------------------------------------------------
VITE_APP_NAME=Saga Elite

# ---- Social login (OPTIONAL — blank hides the corresponding button) -------
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
